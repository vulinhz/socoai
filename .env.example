# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional model name or comma-separated fallback list (e.g. "gemini-4-hydrogen,gemini-3.1-flash-lite,gemini-2.5-flash").
GEMINI_MODEL=""

# APP_URL: The public URL where this app is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign access and refresh tokens on the server.
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# VITE_API_URL: Optional external backend base URL if frontend and API are deployed separately (leave empty for same-origin /api).
VITE_API_URL=""

# FRONTEND_URL / ALLOWED_ORIGINS: Optional comma-separated trusted origins allowed by backend CORS policy.
FRONTEND_URL=""
ALLOWED_ORIGINS=""

# DATABASE_PATH: Optional writable filesystem path for SQLite database (defaults to ./data/socrates.db or OS tmpdir on read-only serverless).
DATABASE_PATH=""
